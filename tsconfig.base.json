      "@hp/client/shared/core/components/toolbar": [
        "libs/client/shared/core/components/toolbar/src/index.ts"
      ],
      "@hp/client/shared/core/configs/translations": [
        "libs/client/shared/core/configs/translations/src/index.ts"
      ],
      "@hp/client/shared/core/guards/can-leave-form": [
        "libs/client/shared/core/guards/can-leave-form/src/index.ts"
      ],
      "@hp/client/utils": ["libs/client/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
