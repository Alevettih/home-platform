{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2024", "dom"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@hp/client/data/models": ["libs/client/data/models/src/index.ts"],
      "@hp/client/data/platform-data-bus": [
        "libs/client/data/platform-data-bus/src/index.ts"
      ],
      "@hp/client/data/resolvers/app-info": [
        "libs/client/data/resolvers/app-info/src/index.ts"
      ],
      "@hp/client/features/shell/common/components/app-info": [
        "libs/client/features/shell/common/components/app-info/src/index.ts"
      ],
      "@hp/client/features/shell/common/components/language-switcher": [
        "libs/client/features/shell/common/components/language-switcher/src/index.ts"
      ],
      "@hp/client/features/shell/common/components/layout": [
        "libs/client/features/shell/common/components/layout/src/index.ts"
      ],
      "@hp/client/features/shell/common/components/theme-switcher": [
        "libs/client/features/shell/common/components/theme-switcher/src/index.ts"
      ],
      "@hp/client/features/shell/containers/platform-root": [
        "libs/client/features/shell/containers/platform-root/src/index.ts"
      ],
      "@hp/client/features/shell/modules/applications/common/components/form": [
        "libs/client/features/shell/modules/applications/common/components/form/src/index.ts"
      ],
      "@hp/client/features/shell/modules/applications/common/utils": [
        "libs/client/features/shell/modules/applications/common/utils/src/index.ts"
      ],
      "@hp/client/features/shell/modules/applications/containers/form": [
        "libs/client/features/shell/modules/applications/containers/form/src/index.ts"
      ],
      "@hp/client/features/shell/modules/applications/containers/list": [
        "libs/client/features/shell/modules/applications/containers/list/src/index.ts"
      ],
      "@hp/client/features/shell/modules/applications/routing": [
        "libs/client/features/shell/modules/applications/routing/src/index.ts"
      ],
      "@hp/client/features/shell/routing": [
