{
  "name": "client-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "hp",
  "sourceRoot": "apps/client-example/src",
  "tags": [
    "app:example",
    "scope:client"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "tsConfig": "apps/client-example/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "client-example:esbuild:production"
        },
        "development": {
          "target": "client-example:esbuild:development",
          "dev": true
        },
        "docker": {
          "target": "client-example:esbuild:docker",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-architects/native-federation:build",
      "configurations": {
        "production": {
          "target": "client-example:serve-original:production"
        },
        "development": {
          "target": "client-example:serve-original:development"
        },
        "docker": {
          "target": "client-example:serve-original:docker"
        }
      },
      "options": {
        "rebuildDelay": 300,
        "dev": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/client-example",
        "index": "apps/client-example/src/index.html",
        "browser": "apps/client-example/src/main.ts",
        "polyfills": [
          "es-module-shims"
        ],
        "tsConfig": "apps/client-example/tsconfig.app.json",
        "inlineStyleLanguage": "less",
        "assets": [
          {
            "glob": "app.metadata.json",
            "input": "apps/client-example/src"
          },
          {
            "glob": "**/*",
            "input": "apps/client-example/public"
          },
          {
            "glob": "**/*",
            "input": "assets/i18n",
            "output": "assets/i18n"
          },
          {
            "glob": "**/*",
            "input": "node_modules/@taiga-ui/icons/src",
            "output": "assets/taiga-ui/icons"
          }
        ],
        "styles": [
          "node_modules/@taiga-ui/core/styles/taiga-ui-theme.less",
          "node_modules/@taiga-ui/core/styles/taiga-ui-fonts.less",
          "apps/client-example/src/styles.less"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "docker": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "baseHref": "/host-example",
          "deployUrl": "/host-example"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "client-example:esbuild:production"
        },
        "development": {
          "buildTarget": "client-example:esbuild:development"
        },
        "docker": {
          "buildTarget": "client-example:esbuild:docker",
          "host": "0.0.0.0",
          "poll": 1000
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "client-example:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/client-example/jest.config.ts",
        "tsConfig": "apps/client-example/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "client-example:build",
        "staticFilePath": "dist/apps/client-example/browser",
        "spa": true
      }
    }
  }
}
