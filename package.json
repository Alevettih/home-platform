{
  "name": "@hp/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:all",
    "lint": "npm run lint:all",
    "test:affected": "nx affected -t test",
    "lint:affected": "nx affected -t lint --fix",
    "test:all": "nx run-many -t test",
    "lint:all": "nx run-many -t lint --fix",
    "client:build": "nx run-many -p tag:scope:client -t build",
    "client:test": "nx run-many -p tag:scope:client -t test",
    "client:lint": "nx run-many -p tag:scope:client -t lint --fix",
    "client:serve:shell": "nx run client-shell:serve",
    "client:build:shell": "nx run client-shell:build",
    "client:lint:shell": "nx run client-shell:lint",
    "client:test:shell": "nx run client-shell:test",
    "client:serve:example": "nx run client-example:serve",
    "client:build:example": "nx run client-example:build",
    "client:lint:example": "nx run client-example:lint",
    "client:test:example": "nx run client-example:test",
    "docker:local:up": "docker compose -f ./docker-compose.dev.yml up --build",
    "docker:local:logs": "docker compose -f ./docker-compose.dev.yml logs --follow",
    "docker:local:down": "docker compose -f ./docker-compose.dev.yml down",
    "docker:local:restart": "docker compose -f ./docker-compose.dev.yml restart ",
    "prepare": "husky"
  },
  "private": true,
